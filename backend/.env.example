# Cloudstream Web backend configuration — all optional, with sensible defaults.
# Copy to .env and adjust, or pass as environment variables to the container.

# Listen port and host
PORT=8080
HOST=0.0.0.0

# Persistent data directory (extension state + user library)
CLOUDSTREAM_WEB_DATA=data

# Auth: if AUTH_PASSWORD is empty, access is OPEN (dev / trusted LAN only).
# Set it to protect the instance. AUTH_SECRET signs the session token: changing it
# invalidates existing cookies (forced logout for everyone).
AUTH_PASSWORD=
AUTH_SECRET=cloudstream-web-default-secret-change-me

# CORS: empty = same-origin (FE served by Ktor in prod, Vite proxy in dev). Comma-separated
# list of extra hosts if the FE is served from a different origin.
CORS_HOSTS=

# Per-provider timeout for the aggregated search (ms)
SEARCH_TIMEOUT_MS=15000

# Cloudflare challenge solver (FlareSolverr v1 endpoint). Lets extractors behind a Cloudflare
# "Just a moment…" wall resolve stream links. Empty = disabled (challenges degrade gracefully,
# as before). docker-compose sets this to the bundled sidecar automatically; set it manually only
# for a standalone/external FlareSolverr.
FLARESOLVERR_URL=

# Directory of the static frontend build to serve (set inside the container).
# In dev leave it empty and use the Vite server.
FRONTEND_DIR=

# Log format: "text" readable (default, dev) or "json" structured (prod).
LOG_FORMAT=text

# DNS-over-HTTPS: resolves hostnames via an HTTPS DoH endpoint instead of the system/container
# resolver. Bypasses ISP-level DNS blocking/hijacking of extension source domains (which
# otherwise surfaces as a PKIX/certificate error rather than a clean connection failure).
# Falls back to the system resolver per-lookup (e.g. for internal compose hostnames like
# "flaresolverr"), so it's safe to leave enabled even on networks without DNS blocking.
DOH_ENABLED=true
DOH_URL=https://cloudflare-dns.com/dns-query

# Signed token (?token=) validity for the streaming proxy / download endpoints, so a copied
# link works in external players (VLC, curl, download managers) that can't send the session
# cookie. Only matters when AUTH_PASSWORD is set.
STREAM_TOKEN_TTL_HOURS=12

# HLS→MP4 reconstruction (episode "download" button on non-progressive sources): ffmpeg/ffprobe
# binary paths (must be on PATH if left as-is; the Docker image already includes ffmpeg), and how
# long a reconstructed file stays on disk before being pruned.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DOWNLOAD_RETENTION_HOURS=24
